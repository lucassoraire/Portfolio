---
const { image, title, description, spanCols = 1, spanRows = 1 } = Astro.props;
---


<div
  class={`relative group overflow-hidden rounded-xl shadow-lg shadow-white/20 col-span-${spanCols} row-span-${spanRows}`}
>
  <img
    src={image}
    alt={title}
    class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-120"
  />


  <div
    class="absolute inset-0 bg-black/40 transition-opacity duration-500 group-hover:bg-black/60"
  >
  </div>


  <div
    class="absolute inset-0 flex flex-col justify-center items-center text-center text-white p-4
           transition-all duration-500 ease-out"
  >
    <h3
      class="text-3xl font-semibold transition-all duration-500 group-hover:text-6xl group-hover:mb-2 "
    >
      {title}
    </h3>
    <p
      class="text-sm font-semibold transition-all duration-500 group-hover:text-lg group-hover:font-semibold "
    >
      {description}
    </p>
  </div>
</div>
