---
const { title, description, link, image } = Astro.props;
---

<div 
  class="bg-[#161616] rounded-2xl shadow-xl hover:shadow-[0_20px_40px_rgba(0,0,0,0.15)] transition-all duration-300 p-6 group hover:scale-[1.05] transform max-w-4xl mx-auto flex flex-col lg:flex-row items-center lg:items-start gap-6 hover:bg-neutral-800 min-h-[300px]"
>

  <!-- Imagen arriba en mobile, al costado en desktop -->
  <div class="w-full lg:w-1/3 flex justify-center">
    {
      image && (
        <img
  src={image}
  alt={`Imagen del proyecto ${title}`}
  class="rounded-xl object-cover w-full max-w-xs h-[200px] sm:h-[250px] lg:h-[250px]"
/>

      )
    }
  </div>

  <!-- Texto debajo en mobile, al lado en desktop -->
  <div class="flex-1 text-white mt-4 lg:mt-0">
    <h2 class="text-2xl font-bold mb-2">
      {title}
    </h2>
    <p class="mb-4 text-gray-300 whitespace-pre-line">{description}</p>
    <a
      href={link}
      class="inline-block px-6 py-2 border border-white rounded-xl font-semibold hover:bg-white hover:text-black transition-colors duration-300"
    >
      Ver proyecto →
    </a>
  </div>
</div>


