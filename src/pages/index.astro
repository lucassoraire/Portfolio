---
import Header from "../components/header.astro";
import Aboutme from "../components/Aboutme.astro";
import Stats from "../components/Stats.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillCard from "../components/SkillCard.astro";
import Stack from "../components/stack.astro"
import Contact from "../components/Contact.astro";
import "../styles/global.css";
// Importa así (con client:only)
import SmoothScroll from '../components/SmoothScroll.jsx'

---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Inicio | Lucas Soraire</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"/>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

  </head>
  <body class="bg-black text-gray-100 font-sans " data-scroll-container>

    <SmoothScroll client:only="react" />
    <Header />
    <main class="pt-15">
        

      <section id="aboutme" class="scroll-mt-40 overflow-x-hidden sm:mt-0" data-scroll-section>
        <Aboutme image="/assets/imglucas.png" />
        <Stats />
      </section>

      <h2 class="text-4xl font-bold mb-4 text-center mt-20 text-white " data-scroll-section>
        Mirá algunos de mis <span class="text-sky-600">proyectos</span>
      </h2>
          <p class="text-gray-400 max-w-2xl mx-auto text-center font-semibold mb-2 mt-1" data-scroll-section >
      Realizados durante la carrera,  donde apliqué soluciones,  combinando diseño y tecnología.
    </p>
      <section
        class="max-w-6xl mx-auto p-4 grid gap-8 md:grid-cols-2 lg:grid-cols-1 scroll-mt-40" data-scroll-section
        id="proyectos"
      >
        <div>
          <ProjectCard
            title="Hotel Niluma 🏨 - Sitio Web"
            description={`Proyecto responsive con varias páginas.\n Incluye galería de imágenes y optimización SEO.`}
            link="/proyectos/infohotel"
            image="/assets/hotelnilumauno.png" 
          />
        </div>
        <div>
          <ProjectCard
            title="Puerto Barc.Co 🚢 - Sistema de Gestión"
            description={"App en Java con conexión a base de datos SQL y funcionalidades CRUD. Trabajado con Programación Orientada a Objetos."}
            link="/proyectos/infopuerto"
            image="/assets/puertouno.jpg"
          />
        </div>
        <div>
          <ProjectCard
            title="Nike 👟 - Landing Page"
            description={"Landing page moderna en HTML y CSS. \n Algo mas simple para una presentación de productos, dando información útil de Nike."}
            link="/proyectos/infonike"
            image="/assets/imgnikefirst.png"
          />
        </div>
      </section>

      <div class="flex justify-center items-center" >
          <a href="#stack">
            <button class="bg-amber-50 rounded-xl py-3 px-5 text-sky-600 font-semibold cursor-pointer mt-3">Stack abajo ↓</button>
          </a>
      </div>

      <section class="mt-30 px-5 py-5 mx-10 md:mx-30 border border-r-amber-50 rounded-xl scroll-mt-25" id="stack" data-scroll-section>
        <Stack>
      </section>

      <section class="max-w-6xl mx-auto px-6 py-16 scroll-mt-5" id="objetivos" data-scroll-section>
        <h2 class="text-3xl font-bold text-center mt-16">Objetivos</h2>
        <p class="text-xl font-semibold text-center"> Mis metas y motivaciones</p>
        
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-8 auto-rows-[150px] md:auto-rows-[250px] mt-15"
        >
          <SkillCard
            image="/assets/potenciar.jpg"
            title="Potenciar ideas escalables"
            description="Siempre hay algo para mejorar y llevar el serivcio/producto a otro nivel."
            spanCols={2}
            
          />
          <SkillCard
            image="/assets/potenciar.jpg"
            title="Diseño UI/UX"
            description="Mi formación personal va enfocado 100% a mejorar la experiencia del usuario en cada click."
          />
          <SkillCard
            image="/assets/potenciar.jpg"
            title="Aplicar mis conocimientos"
            description="Aportar a cada proyecto que tenga cada una de las cosas que aprendí."
            spanRows={2}
          />
          <SkillCard
            image="/assets/potenciar.jpg"
            title="Colaborar en entornos reales"
            description="Busco trabajar en contextos que me ayuden a crecer tanto personal como profesionalmente. "
          />
        </div>
      </section>



      <section id="contacto" class="scroll-mt-10" data-scroll-section>
        <Contact />
      </section>

      <footer class="bg-neutral-900 py-8 mt-16 border-t border-opacity-50" data-scroll-section>
        <div
          class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center text-white-700"
        >
          <div class="mb-4 md:mb-0 text-center md:text-left text-white">
            <p class="font-bold text-lg">Contacto</p>
            <p class="font-medium">Email: lucassoraire100@gmail.com</p>
            <p class="font-medium">Tel: +54 11 3660-6826</p>
          </div>

          <div class="items-center mb-5 sm:mb-0 shadow-lg shadow-white/20">
              <img src="/favicon.ico" alt="icon LS">
          </div>

          <div class="text-center text-l text-white font-semibold">
            <p>{new Date().getFullYear()} • Lucas Soraire - Portfolio.</p>
          </div>
        </div>
      </footer>
    </main>

    <script type="module" src="/scripts/init-aos.js"></script>
    <script>
      document.addEventListener('astro:after-swap', () => {
        window.dispatchEvent(new Event('scroll'));
      });
    </script>




  </body>
</html>
